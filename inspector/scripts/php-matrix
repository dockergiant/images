#!/bin/sh
# Traces a small PHP request through each php-fpm image and checks what the
# tracer and the Excimer prepend send to the Inspector intake.
#
# usage: scripts/php-matrix [--build] VERSION...
#   scripts/php-matrix 8.5 8.3
#
# Per version it runs full, lean, off and debug (PHPMATRIX_RUNS overrides the
# list), each on its own throwaway network with a capture server answering as
# inspector:8126, then runs the phpmatrix Go test over what was captured.
# --build builds a missing ghcr.io/dockergiant/php-fpm[-debug]:VERSION tag
# locally, the way CI does; nothing is pushed.
# PHPMATRIX_OUT keeps the captures in a chosen directory.
set -eu

root=$(cd "$(dirname "$0")/.." && pwd)
repo=$(cd "$root/.." && pwd)
td=$root/testdata/phpmatrix
registry=ghcr.io/dockergiant
runs=${PHPMATRIX_RUNS:-full lean off debug}

build=0
while [ $# -gt 0 ]; do
  case "$1" in
    --build) build=1; shift ;;
    -h|--help) sed -n '2,15p' "$0"; exit 0 ;;
    -*) echo "php-matrix: unknown option $1" >&2; exit 2 ;;
    *) break ;;
  esac
done
if [ $# -eq 0 ]; then
  echo "usage: scripts/php-matrix [--build] VERSION..." >&2
  exit 2
fi

out=${PHPMATRIX_OUT:-$(mktemp -d "${TMPDIR:-/tmp}/phpmatrix.XXXXXX")}
mkdir -p "$out"
out=$(cd "$out" && pwd)
id=phpmatrix-$$
containers=""
networks=""
failed=0

cleanup() {
  for c in $containers; do
    docker rm -f "$c" >/dev/null 2>&1 || true
  done
  for n in $networks; do
    docker network rm "$n" >/dev/null 2>&1 || true
  done
  containers=""
  networks=""
}
trap cleanup EXIT
trap 'exit 130' INT TERM

result() {
  printf '%-4s %-10s %s\n' "$1" "$2" "$3"
  if [ "$1" = FAIL ]; then
    failed=1
  fi
}

# Same OS release the mirror tags use: bullseye up to 8.0, bookworm from 8.1.
os_release() {
  case "$1" in
    7.*|8.0) echo bullseye ;;
    *) echo bookworm ;;
  esac
}

have_image() {
  docker image inspect "$1" >/dev/null 2>&1
}

ensure_image() {
  v=$1 kind=$2 image=$3
  if have_image "$image"; then
    return 0
  fi
  if [ "$build" != 1 ]; then
    return 1
  fi
  echo "building $image" >&2
  if [ "$kind" = debug ]; then
    docker build -f "$repo/php-fpm/xdebug3/Dockerfile" \
      --build-arg ENV_SOURCE_IMAGE=$registry/php-fpm \
      --build-arg PHP_VERSION="$v" --build-arg XDEBUG_TYPE=xdebug \
      -t "$image" "$repo/php-fpm/context" >"$out/build-$kind-$v.log" 2>&1
  else
    docker build -f "$repo/php-fpm/Dockerfile" \
      --build-arg PHP_VERSION="$v" --build-arg OS_RELEASE="$(os_release "$v")" \
      -t "$image" "$repo/php-fpm/context" >"$out/build-$kind-$v.log" 2>&1
  fi
}

start() {
  name=$1
  shift
  containers="$containers $name"
  docker run -d --name "$name" "$@" >/dev/null
}

# wait_for SECONDS COMMAND...: retries the command once a second.
wait_for() {
  n=$1
  shift
  while [ "$n" -gt 0 ]; do
    if "$@" >/dev/null 2>&1; then
      return 0
    fi
    n=$((n - 1))
    sleep 1
  done
  return 1
}

capture_listening() {
  docker exec "$id-capture" python -c "import socket; socket.create_connection(('127.0.0.1', 8126), 1)"
}

fpm_ready() {
  docker logs "$id-php" 2>&1 | grep -q 'ready to handle connections' &&
    [ "$(docker exec "$id-nginx" curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1/ping)" = 200 ]
}

count_path() {
  grep -l "\"path\": \"$1" "$2"/req-*.json 2>/dev/null | wc -l | tr -d ' '
}

traces_flushed() {
  [ "$(count_path /v0.4/traces "$1")" -ge 1 ] && [ "$(count_path /profiles/ "$1")" -ge 3 ]
}

run_one() {
  v=$1 mode=$2
  label=$v/$mode
  dir=$out/$v/$mode
  rm -rf "$dir"
  mkdir -p "$dir/capture"

  image=$registry/php-fpm:$v
  if [ "$mode" = debug ]; then
    image=$registry/php-fpm-debug:$v
  fi
  if ! ensure_image "$v" "$( [ "$mode" = debug ] && echo debug || echo base )" "$image"; then
    if [ "$build" = 1 ]; then
      result FAIL "$label" "build of $image failed, see $out/build-*-$v.log"
    else
      result SKIP "$label" "$image is not here; --build builds it"
    fi
    return 0
  fi

  env_args="-e ROLL_ENV_NAME=matrix"
  case "$mode" in
    full|debug) env_args="$env_args -e ROLL_INSPECTOR_TRACE=1 -e ROLL_INSPECTOR_PROFILE=excimer" ;;
    lean) env_args="$env_args -e ROLL_INSPECTOR_TRACE=1 -e ROLL_INSPECTOR_PROFILE=excimer -e ROLL_INSPECTOR_TRACE_DETAIL=lean" ;;
    off) env_args="$env_args -e ROLL_INSPECTOR_TRACE=0" ;;
    *) result FAIL "$label" "unknown run $mode"; return 0 ;;
  esac
  printf '{"version":"%s","mode":"%s","image":"%s"}\n' "$v" "$mode" "$image" >"$dir/run.json"

  net=$id-net
  networks="$net"
  docker network create "$net" >/dev/null

  start "$id-capture" --network "$net" --network-alias inspector \
    -v "$td/capture.py:/capture.py:ro" -v "$dir/capture:/capture" \
    python:3.12-slim python -u /capture.py /capture
  start "$id-redis" --network "$net" --network-alias redis redis:7-alpine
  if ! docker run --rm --entrypoint php "$image" -m 2>/dev/null | grep -qx pdo_sqlite; then
    start "$id-mysql" --network "$net" --network-alias mysql \
      -e MARIADB_ROOT_PASSWORD=matrix -e MARIADB_DATABASE=matrix mariadb:11.4
    if ! wait_for 120 docker exec "$id-mysql" mariadb -uroot -pmatrix -e 'SELECT 1' matrix; then
      result FAIL "$label" "mysql fallback did not start"
      cleanup
      return 0
    fi
  fi
  # The prepend connects with a 100 ms timeout, so inspector must answer before php-fpm starts.
  if ! wait_for 60 capture_listening; then
    result FAIL "$label" "capture server did not listen on 8126"
    docker logs "$id-capture" >"$dir/capture.log" 2>&1 || true
    cleanup
    return 0
  fi

  # shellcheck disable=SC2086
  start "$id-php" --network "$net" --network-alias php-fpm \
    -v "$td/www:/srv/matrix:ro" $env_args "$image"
  start "$id-nginx" --network "$net" --network-alias nginx \
    -v "$td/nginx.conf:/etc/nginx/conf.d/default.conf:ro" nginx:alpine

  if ! wait_for 180 fpm_ready; then
    result FAIL "$label" "php-fpm or nginx did not come up, see $dir/php-fpm.log"
    docker logs "$id-php" >"$dir/php-fpm.log" 2>&1 || true
    cleanup
    return 0
  fi

  : >"$dir/requests.tsv"
  for i in 1 2 3; do
    xid=$((424200 + i))
    resp=$(docker exec "$id-nginx" curl -sS --max-time 60 -H "X-Varnish: $xid" \
      -w '\n%{http_code}' http://127.0.0.1/matrix.php 2>&1) || true
    status=$(printf '%s\n' "$resp" | tail -n 1)
    printf '%s\n' "$resp" | sed '$d' >"$dir/response-$i.json"
    printf '%s\t%s\t%s\n' "$i" "$xid" "$status" >>"$dir/requests.tsv"
    if [ "$status" = 200 ]; then
      result ok "$label" "request $i (X-Varnish $xid) answered 200"
    else
      result FAIL "$label" "request $i (X-Varnish $xid) answered '$status'"
    fi
  done

  # dd-trace flushes about once a second; the load on this machine can stretch that.
  if [ "$mode" = off ]; then
    sleep 5
  elif wait_for 45 traces_flushed "$dir/capture"; then
    sleep 3
  else
    result FAIL "$label" "no trace payload plus 3 profiles within 45 s"
  fi

  docker exec "$id-php" sh -c 'cd /usr/local/etc/php/conf.d && for f in 98-ddtrace.ini 99-inspector-*.ini; do [ -f "$f" ] && { echo "== $f"; cat "$f"; }; done; true' >"$dir/ini.txt" 2>&1 || true
  # SIGQUIT stops FPM gracefully, which lets the sidecar flush what it still holds.
  docker stop -t 20 "$id-php" >/dev/null 2>&1 || true
  sleep 2
  docker logs "$id-php" >"$dir/php-fpm.log" 2>&1 || true
  docker logs "$id-capture" >"$dir/capture.log" 2>&1 || true
  cleanup

  result ok "$label" "captured $(count_path /v0.4/traces "$dir/capture") trace and $(count_path /profiles/ "$dir/capture") profile posts, $(find "$dir/capture" -name '*.json' | wc -l | tr -d ' ') requests in all"
}

for v in "$@"; do
  for mode in $runs; do
    run_one "$v" "$mode"
  done
done

echo "captures in $out"
containers="$id-go"
set +e
docker run --rm --name "$id-go" \
  -v "$root":/src -w /src \
  -v roll-inspector-gomod:/go/pkg/mod \
  -v roll-inspector-gocache:/root/.cache/go-build \
  -v "$out":/capture:ro \
  -e CGO_ENABLED=0 -e GOFLAGS=-mod=mod \
  -e PHPMATRIX_DIR=/capture \
  golang:1.27-alpine go test -tags phpmatrix -run '^TestPHPMatrix$' -count=1 -v ./internal/apm \
  >"$out/go-test.log" 2>&1
gostatus=$?
set -e
sed -n 's/^phpmatrix: //p' "$out/go-test.log"
if [ "$gostatus" -ne 0 ] && ! grep -q '^phpmatrix: FAIL' "$out/go-test.log"; then
  tail -n 30 "$out/go-test.log"
fi
if [ "$gostatus" -ne 0 ]; then
  failed=1
fi

if [ "$failed" -ne 0 ]; then
  echo "php-matrix: FAILED (log: $out/go-test.log)"
  exit 1
fi
echo "php-matrix: all checks passed"
